# MongoDB Connection URI (ReplicaSet or SRV format)
MONGODB_URI=mongodb://username:password@shard0,shard1,shard2/xian_loyalty?ssl=true&replicaSet=atlas-xxx-shard-0&authSource=admin&retryWrites=true&w=majority

# JWT Secret for Session Signing
JWT_SECRET=xian_loyalty_super_secure_secret_2026_jwt_token

# White-Label Default Store Configuration
NEXT_PUBLIC_DEFAULT_STORE_NAME=xian
NEXT_PUBLIC_DEFAULT_TAGLINE=Restaurante Oriental
NEXT_PUBLIC_DEFAULT_CURRENCY=JOD
NEXT_PUBLIC_DEFAULT_POINTS_PER_UNIT=10
NEXT_PUBLIC_DEFAULT_DISCOUNT_PER_100_PTS=1.00
NEXT_PUBLIC_DEFAULT_BRAND_COLOR=#f7f2e4
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#cb202d

# Google OAuth Credentials (for customer login & signup)
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Web Push VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key
VAPID_PRIVATE_KEY=your_private_vapid_key
VAPID_SUBJECT=mailto:admin@xianrestaurant.com
